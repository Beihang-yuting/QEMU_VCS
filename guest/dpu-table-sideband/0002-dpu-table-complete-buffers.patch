+/* COSIM_TABLE_SIDEBAND_PATCH_0002 */
+static inline void wr32_for_each(struct dpu_hw *hw, u64 reg,
+				 const void *value, u32 size)
+{
+	enum dpu_table_submit_result result;
+	int __n;
